{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "algobot-latest",
  "account_id": "ad5d01b72261ea7ae64b9f3ed114564e",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "algobot.fun", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
